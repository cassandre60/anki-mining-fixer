{
  "config_version": 1,
  "deck_name": "My Life Decks::Japanese::My New Japanese Deck",
  "note_type_name": "Japanese Note type (Sentence card by Default)",
  "shortcut_fix": "Ctrl+Alt+F",
  "window_days": 3,
  "preview_last_n": 30,
  "scene_auto_gap_hours": 6,
  "batch_expand_sentence": true,
  "batch_replace_source": true,
  "batch_scene_propagation": true,
  "batch_repair_sentence": true,
  "sentence_repair_rules": [
    "flatten-div-blocks",
    "strip-arrows",
    "join-speaker-lines",
    "strip-dash",
    "strip-nbsp",
    "normalize-parens",
    "strip-inline-readings"
  ],
  "batch_regenerate_furigana": true,
  "batch_repair_expression": true,
  "batch_bold_inflected": true,
  "min_sentence_len": 6,
  "scene_fill_fields": [
    "Sentence Audio",
    "Picture",
    "Sentence (furigana)",
    "Translation"
  ],
  "scene_replace_fields": [
    "Source",
    "Sentence"
  ],
  "scene_optin_fields": [
    "Notes",
    "context",
    "Kanji Notes"
  ],
  "word_fill_fields": [
    "Pitch Accent",
    "Frequency",
    "Word Audio",
    "furigana",
    "reading"
  ],
  "never_copy_fields": [
    "cloze-prefix",
    "cloze-body",
    "cloze-suffix",
    "Definition",
    "Extended definition"
  ],
  "definition_fields": [
    "Definition",
    "Extended definition"
  ],
  "translation_autocheck": true,
  "notes_autocheck": false,
  "replaces_autocheck": true,
  "optout_tag": "no-autofill",
  "applied_tag": "auto-filled",
  "batch_strip_inline_readings": true
}
